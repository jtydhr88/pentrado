{
  "name": "pentrado",
  "version": "0.1.0",
  "private": true,
  "description": "Pentrado — a layered 2D image editor engine: real layers, masks, selections, vector shapes, adjustment layers, PSD import/export.",
  "author": "jtydhr88",
  "license": "MIT",
  "homepage": "https://pentrado.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/jtydhr88/pentrado"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "deploy": "npm run build && wrangler pages deploy ./dist --project-name=pentrado --branch=main"
  },
  "dependencies": {
    "ag-psd": "^31.0.2",
    "reka-ui": "^2.10.1",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.115",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.2",
    "unplugin-icons": "^22.5.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.8",
    "vue-tsc": "^2.1.10",
    "wrangler": "^4.40.0"
  }
}
