{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "unplugin-icons/types/vue", "vitest/globals"],
    "paths": {
      "@jtydhr88/pentrado": ["./src"]
    }
  },
  "include": ["src/**/*", "site/**/*"],
  "exclude": ["node_modules", "dist", "src/vendor/**"]
}
